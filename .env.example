# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your numeric Telegram user id (get it from @userinfobot). Only this
# account can use the owner control center.
OWNER_ID=123456789

# Random secret. Used BOTH as the webhook URL path and as Telegram's
# secret_token header, so nobody else can post fake updates to your bot.
# Generate one with:  openssl rand -hex 24
WEBHOOK_SECRET=replace-with-a-long-random-string

# Public https URL of your deployed app (no trailing slash). Only needed
# by `deno task webhook:set`.  e.g. https://my-bot.deno.dev
PUBLIC_URL=https://my-bot.deno.dev

# Your timezone as minutes offset from UTC, used when you type schedule
# times like "2026-10-01 10:00". Manila = 480, London = 0, New York = -300.
TZ_OFFSET_MINUTES=480
